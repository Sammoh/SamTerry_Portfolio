MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0000000000000000, type: 3}
  m_Name: BannerContainerConfiguration
  backgroundColor: {r: 0.2, g: 0.6, b: 1, a: 0.8}
  textColor: {r: 1, g: 1, b: 1, a: 1}
  customFont: {fileID: 0}
  textAlignment: 4
  enableClickInteraction: 1
  enableSmartResize: 1
